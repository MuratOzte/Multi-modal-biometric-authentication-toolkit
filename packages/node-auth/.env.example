# Node does not automatically load this file; export variables in your shell.
PORT=3001
MOCK_IP_CHECK=1
PYTHON_CMD=python
PYTHON_BIN=python
# Set this and MOCK_IP_CHECK=0 to enable real IP checks.
VPNAPI_KEY=replace_with_your_key

# Optional workers; use absolute paths for separate Python environments.
FACE_PYTHON_BIN=python
FACE_DEVICE=auto
FACE_REQUIRE_GPU=false
VOICE_PYTHON_BIN=python
VOICE_DEVICE=auto
VOICE_REQUIRE_GPU=false
VOICE_WHISPER_MODEL=base
CARD_PYTHON_BIN=python
