{
  "name": "securekit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:node": "node scripts/dev.mjs node",
    "lint": "echo \"(todo)\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter @securekit/node-auth --filter @securekit/web-sdk test",
    "test:biometric-preflight": "node scripts/biometric-preflight.mjs",
    "test:biometric-acceptance": "node scripts/biometric-acceptance.mjs",
    "test:biometric-tools": "dotnet build SecureKit.slnx && node --test scripts/biometric-acceptance.test.mjs",
    "test:aspnet-parity": "dotnet build SecureKit.slnx && node scripts/aspnet-parity.mjs",
    "test:aspnet-demo": "dotnet build SecureKit.slnx && pnpm --filter demo-web test:aspnet-smoke"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  }
}
