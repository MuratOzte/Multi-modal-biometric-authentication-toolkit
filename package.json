{
  "name": "securekit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @securekit/node-auth --filter demo-web dev",
    "lint": "echo \"(todo)\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter @securekit/node-auth --filter @securekit/web-sdk test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  }
}
